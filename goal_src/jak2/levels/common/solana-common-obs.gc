(defmethod crate-init! ((this pickup-spawner) (arg0 entity-actor))
  "Initialize the [[crate]] with the specified [[entity-actor]]."
  (let ((t9-0 (method-of-type crate crate-init!)))
    (t9-0 this arg0)
    )
  (set! (-> this look) 'none)
  (set! (-> this blocker) #f)
  (if (logtest? (-> this fact options) (actor-option blocked))
      (set! (-> this blocker) (entity-actor-lookup (-> this entity) 'alt-actor 0))
      )
  (none)
  )

(deftype vendor (process-drawable)
  ((root       collide-shape-moving :override)
   (birth-time time-frame)
   (base       vector :inline)
   (old-base   vector :inline)
   (bob-offset int64)
   (bob-amount float))
  (:methods
   (init-collision! (_type_) object))
  (:state-methods
   idle))

(def-actor vendor
  :bounds (0 0 0 5))

(defmethod init-collision! ((this vendor))
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction) (the (function collide-shape-moving collide-query vector vector object) nothing))
    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the uint 0) (the uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-spec pusher))
      (set! (-> mesh collide-with) (collide-spec jak player-list))
      (set! (-> mesh prim-core action) (collide-action solid rideable))
      (set! (-> mesh transform-index) 0)
      (set! (-> cshape total-prims) (the uint 1))
      (set! (-> cshape root-prim) mesh)
      (set-vector! (-> mesh local-sphere) 0.0 (meters 0) 0.0 (meters 5)))
    (pusher-init cshape)
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)))

(defmethod init-from-entity! ((this vendor) (e entity-actor))
  (logior! (-> this mask) (process-mask enemy))
  (init-collision! this)
  (process-drawable-from-entity! this e)
  (set! (-> this bob-amount) 1024.0)
  (set! (-> this bob-offset)
        (+ (the int (-> this root trans x)) (the int (-> this root trans y)) (the int (-> this root trans z))))
  (set-time! (-> this birth-time))
  (vector-copy! (-> this base) (-> this root trans))
  (vector-copy! (-> this old-base) (-> this root trans))
  (initialize-skeleton this *vendor-sg* '())
  (logclear! (-> this mask) (process-mask actor-pause))
  (transform-post)
  (go-virtual idle :proc this)
  (none))

(defbehavior vendor-init-by-other vendor ((pos vector))
  (logior! (-> self mask) (process-mask enemy))
  (init-collision! self)
  (initialize-skeleton self *vendor-sg* '())
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self bob-amount) 1024.0)
  (set! (-> self bob-offset)
        (+ (the int (-> self root trans x)) (the int (-> self root trans y)) (the int (-> self root trans z))))
  (set-time! (-> self birth-time))
  (vector-copy! (-> self base) (-> self root trans))
  (vector-copy! (-> self old-base) (-> self root trans))
  (logclear! (-> self mask) (process-mask actor-pause))
  (transform-post)
  (go-virtual idle))

(defstate idle (vendor)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack 'touch)
         ; (if (= (-> proc type) target)
         ;   (send-event proc 'attack #f (static-attack-info ((shove-up (meters 2.5)) (shove-back (meters 7.5)))))
         ;   )
         #t)))
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees -45) (seconds-per-frame)))
        ;; (let ((bob (-> self bob-amount)))
        ;;   (when (< 0.0 bob)
        ;;     (set! (-> self root trans y)
        ;;           (+ (-> self base y)
        ;;              (* bob
        ;;                 (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 2))))))))
        ;;     (update-transforms (-> self root))))
        ; (debug-draw-tris (-> (res-lump-struct (-> self draw art-group data 0 extra) 'collide-mesh-group (array collide-mesh)) 0) self 2)
        ; (dotimes (i (-> self node-list length))
        ;   (let* ((joint (-> self node-list data i)) (jpos (vector<-cspace! (new-stack-vector0) joint)))
        ;     (add-debug-sphere #t (bucket-id debug) jpos (meters 0.1) (static-rgba 0 #xff 0 #x40))
        ;     (add-debug-text-sphere (!= (-> joint joint) #f) (bucket-id debug) jpos (meters 0.1) (-> joint joint name) (static-rgba 0 #xff 0 #x40))
        ;     )
        ;   )
        (suspend)))
  :post transform-post)


(deftype teleporter (process-drawable)
  ((root       collide-shape-moving :override)
   (birth-time time-frame)
   (base       vector :inline)
   (old-base   vector :inline)
   (bob-offset int64)
   (bob-amount float))
  (:methods
   (init-collision! (_type_) object))
  (:state-methods
   idle))

(def-actor teleporter
  :bounds (0 0 0 5))

(defmethod init-collision! ((this teleporter))
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction) (the (function collide-shape-moving collide-query vector vector object) nothing))
    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the uint 0) (the uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-spec pusher))
      (set! (-> mesh collide-with) (collide-spec jak player-list))
      (set! (-> mesh prim-core action) (collide-action solid rideable))
      (set! (-> mesh transform-index) 0)
      (set! (-> cshape total-prims) (the uint 1))
      (set! (-> cshape root-prim) mesh)
      (set-vector! (-> mesh local-sphere) 0.0 (meters 0) 0.0 (meters 5)))
    (pusher-init cshape)
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)))

(defmethod init-from-entity! ((this teleporter) (e entity-actor))
  (logior! (-> this mask) (process-mask enemy))
  (init-collision! this)
  (process-drawable-from-entity! this e)
  (set! (-> this bob-amount) 1024.0)
  (set! (-> this bob-offset)
        (+ (the int (-> this root trans x)) (the int (-> this root trans y)) (the int (-> this root trans z))))
  (set-time! (-> this birth-time))
  (vector-copy! (-> this base) (-> this root trans))
  (vector-copy! (-> this old-base) (-> this root trans))
  (initialize-skeleton this *teleporter-sg* '())
  (logclear! (-> this mask) (process-mask actor-pause))
  (transform-post)
  (go-virtual idle :proc this)
  (none))

(defbehavior teleporter-init-by-other teleporter ((pos vector))
  (logior! (-> self mask) (process-mask enemy))
  (init-collision! self)
  (initialize-skeleton self *teleporter-sg* '())
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self bob-amount) 1024.0)
  (set! (-> self bob-offset)
        (+ (the int (-> self root trans x)) (the int (-> self root trans y)) (the int (-> self root trans z))))
  (set-time! (-> self birth-time))
  (vector-copy! (-> self base) (-> self root trans))
  (vector-copy! (-> self old-base) (-> self root trans))
  (logclear! (-> self mask) (process-mask actor-pause))
  (transform-post)
  (go-virtual idle))

(defstate idle (teleporter)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack 'touch)
         ; (if (= (-> proc type) target)
         ;   (send-event proc 'attack #f (static-attack-info ((shove-up (meters 2.5)) (shove-back (meters 7.5)))))
         ;   )
         #t)))
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees 45) (seconds-per-frame)))
        (let ((bob (-> self bob-amount)))
          (when (< 0.0 bob)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (* bob
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 2))))))))
            (update-transforms (-> self root))))
        ; (debug-draw-tris (-> (res-lump-struct (-> self draw art-group data 0 extra) 'collide-mesh-group (array collide-mesh)) 0) self 2)
        ; (dotimes (i (-> self node-list length))
        ;   (let* ((joint (-> self node-list data i)) (jpos (vector<-cspace! (new-stack-vector0) joint)))
        ;     (add-debug-sphere #t (bucket-id debug) jpos (meters 0.1) (static-rgba 0 #xff 0 #x40))
        ;     (add-debug-text-sphere (!= (-> joint joint) #f) (bucket-id debug) jpos (meters 0.1) (-> joint joint name) (static-rgba 0 #xff 0 #x40))
        ;     )
        ;   )
        (suspend)))
  :post transform-post)

(deftype metalgrabber (collectable)
  ()
  (:state-methods
   wait)
  )

(def-actor metalgrabber
  :bounds (0 0 0 5))

(defmethod do-pickup ((this metalgrabber) (arg0 handle))
  "Handle metalgrabber pickup - close task, play sound effect"
  ;; Close task code will go here
  ;; Read the close-task property as a string
  (let ((task-string (res-lump-struct (-> this entity) 'close-task string)))
    (when task-string
      (format #t "Closing task: ~S~%" task-string)
      (task-close! task-string)
      )
    )
  ;; Play pickup sound
  (sound-play "ammo-pickup")
  
  (none)
  )

(defmethod initialize-allocations ((this metalgrabber))
  "Set up metalgrabber like skill does"
  (stack-size-set! (-> this main-thread) 128)
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> sphere prim-core collide-as) (collide-spec collectable notice-blue-eco-powerup))
      (set! (-> sphere prim-core collide-with) (collide-spec jak player-list tobot))
      (set-vector! (-> sphere local-sphere) 0.0 2048.0 0.0 16384.0) ;; collide sphere 4096.0 = 1 meter, 16384.0 = 4 meters
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) sphere)
      )
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)
    )
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) '#t)
  (set! (-> this notify) (the-as handle #f))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type goldbolt) 1.0))
  
  ;; Set up task like skill/goldbolt does
  (let ((entity (-> this entity)))
    (if (when entity
          (let ((task (-> entity extra perm task)))
            (if task
                (= task (game-task none))
                )
            )
          )
        (set! (-> this entity extra perm task) (game-task complete))
        )
    )
  
  ;; Initialize skeleton - use metalgrabber model
    (initialize-skeleton this *metalgrabber-sg* '())
  
  ;; Add particle effect
  (set! (-> this part) (create-launch-control group-solana-item-glow this))
  
  (set! (-> this draw shadow-ctrl) *collectable-dummy-shadow-control*)
  (if (-> this entity)
      (nav-mesh-connect-from-ent this)
      )
  
  ;; Set metalgrabber color (optional - make it look different)
  ;; (set-vector! (-> this draw color-mult) 1.0 0.8 0.0 1.0)
  ;; (set-vector! (-> this draw color-emissive) 0.3 0.2 0.0 1.0)
  
  0
  (none)
  )

(defmethod init-from-entity! ((this metalgrabber) (arg0 entity-actor))
  "Initialize metalgrabber"
  (initialize-allocations this)
  (process-drawable-from-entity! this (-> this entity))
  (initialize-options this 0 1024.0 (the-as fact-info #f))
  (update-transforms (-> this root))
  (go-to-initial-state this)
  (none)
  )

(defstate wait (metalgrabber)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch)
       ;; Player touched the metalgrabber
       (go-virtual pickup #f (process->handle proc))
       )
      (else
        ;; Let the standard collectable handler deal with other events
        (collectable-standard-event-handler proc argc message block)
        )
      )
    )
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees 45) (seconds-per-frame)))
        (let ((bob (-> self bob-amount)))
          (when (< 0.0 bob)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (* bob
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 2))))))))
            (update-transforms (-> self root))))
        ; (debug-draw-tris (-> (res-lump-struct (-> self draw art-group data 0 extra) 'collide-mesh-group (array collide-mesh)) 0) self 2)
        ; (dotimes (i (-> self node-list length))
        ;   (let* ((joint (-> self node-list data i)) (jpos (vector<-cspace! (new-stack-vector0) joint)))
        ;     (add-debug-sphere #t (bucket-id debug) jpos (meters 0.1) (static-rgba 0 #xff 0 #x40))
        ;     (add-debug-text-sphere (!= (-> joint joint) #f) (bucket-id debug) jpos (meters 0.1) (-> joint joint name) (static-rgba 0 #xff 0 #x40))
        ;     )
        ;   )
        (suspend)))
  :post 
    (behavior ()
      (spawn (-> self part) (-> self root trans))  ;; ADDED: spawn particles every frame
      (transform-post)
    )
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; goldchal - mission kiosk
;;
;; A clone of the vanilla burning-bush behavior, but using the goldchal
;; model/skeleton and goldchal's own collision, with all particle effects
;; removed. It waits for the player to approach, shows the "press triangle
;; to talk" prompt when its game-task event action is `show`, and when
;; triangle is pressed it grabs the player, plays the scene attached to the
;; task event (gui-channel bbush), closes the current task node, and returns
;; to idle.
;;
;; PAYWALL: if the entity lump defines a 'price (int32), the kiosk charges
;; that many orbs (skill) to start - but only ONCE. The first successful
;; payment is remembered in the entity perm (subtask-complete bit), so
;; failing the mission and coming back later starts it for free, and the
;; price line stops being shown. A price of 0 (or no 'price in the lump)
;; means the kiosk is free and behaves exactly as before.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype goldchal (process-focusable)
  ((task   game-task-control)
   (price  int32)
   (angle  degrees)
   (time   float)
   )
  (:state-methods
    idle
    talking
    )
  (:methods
    (init-collision! (_type_) object)
    (player-in-range? (_type_) object)
    (look-at-player! (_type_) none)
    (can-afford? (_type_) symbol)
    (paid? (_type_) object)
    )
  )

(def-actor goldchal
  :bounds (0 0 0 5))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; equivalent of burning-bush-method-32: is the player standing in front of
;; the kiosk, on foot, close enough to interact?
(defmethod player-in-range? ((this goldchal))
  (let* ((to-target (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> this root trans)))
         (side-dist (vector-dot (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)) to-target))
         (fwd-dist (vector-dot (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)) to-target))
         )
    (and *target*
         (not (focus-test? *target* pilot))
         (< (fabs side-dist) (meters 2.5))
         (< 0.0 fwd-dist)
         (< (fabs fwd-dist) (meters 5))
         )
    )
  )

;; does the player have enough orbs to pay this kiosk's price?
;; NOTE: 'skill' is the internal name for Precursor orbs in jak 2.
(defmethod can-afford? ((this goldchal))
  (>= (-> *game-info* bolt) (the float (-> this price)))
  )

;; has this kiosk already been paid for? The flag lives in the entity perm
;; (same persistent per-actor record your goldbolt uses for its task status),
;; so it survives walking away, level reloads, and rides in the save-game
;; perm list. Code-spawned goldchals have no entity and are never "paid".
(defmethod paid? ((this goldchal))
  (and (-> this entity)
       (logtest? (-> this entity extra perm status) (entity-perm-status subtask-complete))
       )
  )

;; equivalent of the rlet blocks in the bush's :post behaviors - make Jak's
;; neck look at a point 5m above the kiosk root.
(defmethod look-at-player! ((this goldchal))
  (when *target*
    (let ((look-pos (new 'stack-no-clear 'vector)))
      (vector+float*! look-pos (-> this root trans) *up-vector* (meters 5))
      (look-at! (-> *target* neck) look-pos #f this)
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; states
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defstate idle (goldchal)
  :virtual #t
  :trans (behavior ()
    (let ((task-event (get-current-task-event (-> self task))))
      ;; interaction prompt + triangle press
      (when (and (or (= (-> task-event action) (game-task-action show))
                     (= (-> task-event action) (game-task-action menu))
                     )
                 (and (player-in-range? self) (can-display-query? self (the-as string #f) -99.0))
                 )
        ;; main prompt
        (let ((ctx (new 'stack 'font-context *font-default-matrix* 32 280 0.0 (font-color default) (font-flags shadow kerning))))
          (set! (-> ctx flags) (font-flags shadow kerning large))
          (set-width! ctx 340)
          (set-height! ctx 80)
          (set-scale! ctx 0.9)
          (let ((print-fn print-game-text))
            (format (clear *temp-string*) (lookup-text! *common-text* (text-id press-triangle-to-talk) #f))
            (print-fn *temp-string* ctx #f 44 (bucket-id progress))
            )
          )
        ;; price line, only when this kiosk charges and hasn't been paid yet
        (when (and (> (-> self price) 0) (not (paid? self)))
          (let ((ctx (new 'stack 'font-context *font-default-matrix* 32 310 0.0 (font-color default) (font-flags shadow kerning))))
            (set! (-> ctx flags) (font-flags shadow kerning large))
            (set-width! ctx 340)
            (set-height! ctx 80)
            (set-scale! ctx 0.7)
            ;; red when the player can't afford it
            (if (not (can-afford? self))
                (set! (-> ctx color) (font-color red))
                )
            (let ((print-fn print-game-text))
              (format (clear *temp-string*) "~D bolts" (-> self price))
              (print-fn *temp-string* ctx #f 44 (bucket-id progress))
              )
            )
          )
        (when (cpad-pressed? 0 triangle)
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
          (cond
            ((or (paid? self) (can-afford? self))
             ;; charge the player on the first purchase only, then remember
             ;; it in the entity perm so retries are free
             (when (and (> (-> self price) 0) (not (paid? self)))
               (-! (-> *game-info* bolt) (the float (-> self price)))
               (process-entity-status! self (entity-perm-status subtask-complete) #t)
                ;; payment sfx: cascade of random bolt sounds, one every
                ;; 2 frames, 16 times. Runs in its own process so it keeps
                ;; playing while the kiosk transitions into the talking state.
                (process-spawn-function process
                  (lambda :behavior process ()
                    (dotimes (i 20)
                      (let ((pick (rand-vu-int-count 4)))
                        (cond
                          ((= pick 0)
                          (play-sound-file "bolt-5-20.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 8.0)))
                          )
                          (else
                            (play-sound-file "bolt-1.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 8.0)))
                            )
                          )
                        )
                      ;; wait 5 frames before the next chink
                      (dotimes (j 3)
                        (suspend)
                        )
                      )
                    (none)
                    )
                  :name "goldchal-pay-sfx"
                  :to *entity-pool*
                  )
               )
             (go-virtual talking)
             )
            (else
              ;; not enough orbs - deny
              (play-sound-file "menu-deny.wav" (the int (* (-> *setting-control* user-current sfx-volume) 130.0)))
              )
            )
          )
        )
      )
    )
  :code sleep-code
  :post (behavior ()
    (look-at-player! self)
    )
  )

(defstate talking (goldchal)
  :virtual #t
  :enter (behavior ()
    (set-setting! 'minimap 'clear 0.0 (minimap-flag minimap))
    (set! (-> self time) -1.0)
    (process-entity-status! self (entity-perm-status no-kill) #t)
    )
  :exit (behavior ()
    (remove-setting! 'music-volume)
    (remove-setting! 'sfx-volume)
    (remove-setting! 'dialog-volume)
    (remove-setting! 'minimap)
    (send-event *camera* 'change-target *target*)
    (remove-setting! 'interp-time)
    (remove-setting! 'mode-name)
    )
  :trans (behavior ()
    ;; sway the fixed camera gently around the kiosk while the scene plays,
    ;; same motion as the bush (30 degree sine sweep on local y).
    (when (!= (-> self time) -1.0)
      (let ((cam-pos (new 'stack-no-clear 'vector))
            (cam-offset (new 'stack-no-clear 'vector))
            (swayed-quat (new 'stack-no-clear 'quaternion))
            )
        (let ((sway-angle (* 182.04445 (* 30.0 (sin (* 7281.778 (-> self time)))))))
          (quaternion-rotate-local-y! swayed-quat (-> self root quat) sway-angle)
          )
        (vector-orient-by-quat! cam-offset (new 'static 'vector :y 16384.0 :z 40960.0 :w 1.0) swayed-quat)
        (vector+! cam-pos (-> self root trans) cam-offset)
        (set! (-> *camera* slave 0 trans quad) (-> cam-pos quad))
        ;; aim the camera at a point 5m above the kiosk
        (let ((look-target (new 'stack-no-clear 'vector)))
          (vector+float*! look-target (-> self root trans) *up-vector* (meters 5))
          (forward-down->inv-matrix
            (-> *camera* slave 0 tracking inv-mat)
            (vector-! (new 'stack-no-clear 'vector) look-target cam-pos)
            (-> *camera* local-down)
            )
          )
        )
      )
    )
  :code (behavior ()
    (set-setting! 'mode-name 'cam-really-fixed 0.0 0)
    (suspend)
    (until (process-grab? *target* #f)
      (suspend)
      )
    (suspend)
    (if *target*
        (set! (-> *target* neck flex-blend) 1.0)
        )
    (add-setting! 'music-volume 'rel (-> *setting-control* user-current music-volume-movie) 0)
    (add-setting! 'sfx-volume 'rel (-> *setting-control* user-current sfx-movie-volume) 0)
    (add-setting! 'dialog-volume 'rel (-> *setting-control* user-current dialog-volume-hint) 0)
    (set-time! (-> self state-time))
    ;; play the scene attached to the current task event
    (let* ((task-event (get-current-task-event (-> self task)))
           (gui-id (add-process
                     *gui-control*
                     self
                     (gui-channel bbush)
                     (gui-action play)
                     (the-as string (-> task-event scene))
                     -99.0
                     0
                     )
                   )
           )
      (while (nonzero? (get-status *gui-control* gui-id))
        (set! (-> self time) (* 0.0033333334 (the float (- (current-time) (-> self state-time)))))
        (suspend)
        ;; allow the player to skip out with triangle
        (when (cpad-pressed? 0 triangle)
          (set-action!
            *gui-control*
            (gui-action stop)
            gui-id
            (gui-channel none)
            (gui-action none)
            (the-as string #f)
            (the-as (function gui-connection symbol) #f)
            (the-as process #f)
            )
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
          (sound-play "inter-burn-bush")
          )
        )
      )
    (until (process-release? *target*)
      (suspend)
      )
    ;; advance the task chain - this is what actually kicks off the mission
    (task-node-close! (-> self task current-node))
    (go-virtual idle)
    )
  :post (behavior ()
    (look-at-player! self)
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; setup
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; goldchal's original collision, unchanged
(defmethod init-collision! ((this goldchal))
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction) (the (function collide-shape-moving collide-query vector vector object) nothing))
    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the uint 0) (the uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-spec pusher))
      (set! (-> mesh collide-with) (collide-spec jak player-list))
      (set! (-> mesh prim-core action) (collide-action solid rideable))
      (set! (-> mesh transform-index) 0)
      (set! (-> cshape total-prims) (the uint 1))
      (set! (-> cshape root-prim) mesh)
      (set-vector! (-> mesh local-sphere) 0.0 (meters 0) 0.0 (meters 5)))
    (pusher-init cshape)
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)))

(defmethod relocate ((this goldchal) (offset int))
  (if (nonzero? (-> this task))
      (&+! (-> this task) offset)
      )
  (the-as goldchal ((method-of-type process-focusable relocate) this offset))
  )

(defmethod run-logic? ((this goldchal))
  "Should this process be run? Checked by execute-process-tree."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (or (and (nonzero? (-> this draw))
               (logtest? (-> this draw status) (draw-control-status on-screen))
               (>= (+ (-> *ACTOR-bank* pause-dist) (-> this root pause-adjust-distance))
                   (vector-vector-distance (-> this root trans) (math-camera-pos))
                   )
               )
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-control-status uninited)))
          )
      )
  )

(defmethod init-from-entity! ((this goldchal) (e entity-actor))
  (init-collision! this)
  (process-drawable-from-entity! this e)
  (initialize-skeleton this *goldchal-sg* '())
  ;; optional yaw offset from the entity, same as the bush
  (let ((rot-offset (res-lump-float (-> this entity) 'rotoffset)))
    (if (!= rot-offset 0.0)
        (quaternion-rotate-local-y! (-> this root quat) (-> this root quat) rot-offset)
        )
    )
  ;; which task actor this kiosk represents - set 'task-actor on the entity
  ;; in your level json, and reference the same actor in the task node's
  ;; when-open event list in game-task.gc
  (set! (-> this task)
        (new 'process 'game-task-control (res-lump-value e 'task-actor game-task-actor :time -1000000000.0))
        )
  ;; the paywall price in bolts, from the 'price int32 in the entity lump.
  ;; missing lump -> 0 -> free kiosk.
  (set! (-> this price)
        (the-as int (res-lump-value e 'price int :default (the-as uint128 0) :time -1000000000.0))
        )
  ;; same trick goldbolt uses: point the entity perm's task at the always-
  ;; complete sentinel so the death/continue perm reset skips this entity.
  ;; Without this, dying clears the perm status bits and wipes our paid flag.
  (let ((entity (-> this entity)))
    (if (when entity
          (let ((task (-> entity extra perm task)))
            (if task
                (= task (game-task none))
                )
            )
          )
        (set! (-> this entity extra perm task) (game-task complete))
        )
    )
  (set! (-> this angle) 0.0)
  (set! (-> this root pause-adjust-distance) 819200.0)
  (transform-post)
  (go (method-of-object this idle))
  (none)
  )

;; spawn by code instead of from an entity. Pass the position, the
;; game-task-actor this kiosk should respond to, and the price in bolts
;; (0 = free), e.g.
;;   (process-spawn goldchal (target-pos 0) (game-task-actor burning-bush-forest) 500
;;                  :name "goldchal" :to *entity-pool*)
(defbehavior goldchal-init-by-other goldchal ((pos vector) (task-actor game-task-actor) (price int))
  (init-collision! self)
  (initialize-skeleton self *goldchal-sg* '())
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self task) (new 'process 'game-task-control task-actor))
  (set! (-> self price) price)
  (set! (-> self angle) 0.0)
  (set! (-> self root pause-adjust-distance) 819200.0)
  (transform-post)
  (go-virtual idle)
  )
