(deftype infobot (collectable)
  ()
  (:state-methods
   wait)
  )

(def-actor infobot
  :bounds (0 0 0 5))

(defmethod do-pickup ((this infobot) (arg0 handle))
  "Handle infobot pickup - close task, play sound effect"
  ;; Close task code will go here
  ;; Read the close-task property as a string
  (let ((task-string (res-lump-struct (-> this entity) 'close-task string)))
    (when task-string
      (format #t "Closing task: ~S~%" task-string)
      (task-close! task-string)
      )
    )
  ;; Play pickup sound
  (sound-play "skill-pickup")
  
  (none)
  )

(defmethod initialize-allocations ((this infobot))
  "Set up infobot like skill does"
  (stack-size-set! (-> this main-thread) 128)
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> sphere prim-core collide-as) (collide-spec collectable notice-blue-eco-powerup))
      (set! (-> sphere prim-core collide-with) (collide-spec jak player-list tobot))
      (set-vector! (-> sphere local-sphere) 0.0 2048.0 0.0 16384.0) ;; collide sphere 4096.0 = 1 meter, 16384.0 = 4 meters
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) sphere)
      )
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)
    )
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) '#t)
  (set! (-> this notify) (the-as handle #f))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type goldbolt) 1.0))
  
  ;; Set up task like skill/goldbolt does
  (let ((entity (-> this entity)))
    (if (when entity
          (let ((task (-> entity extra perm task)))
            (if task
                (= task (game-task none))
                )
            )
          )
        (set! (-> this entity extra perm task) (game-task complete))
        )
    )
  
  ;; Initialize skeleton - use infobot model
    (initialize-skeleton this *infobot-sg* '())
  
  ;; Add particle effect
  (set! (-> this part) (create-launch-control group-solana-item-glow this))
  
  (set! (-> this draw shadow-ctrl) *collectable-dummy-shadow-control*)
  (if (-> this entity)
      (nav-mesh-connect-from-ent this)
      )
  
  ;; Set infobot color (optional - make it look different)
  ;; (set-vector! (-> this draw color-mult) 1.0 0.8 0.0 1.0)
  ;; (set-vector! (-> this draw color-emissive) 0.3 0.2 0.0 1.0)
  
  0
  (none)
  )

(defmethod init-from-entity! ((this infobot) (arg0 entity-actor))
  "Initialize infobot"
  (initialize-allocations this)
  (process-drawable-from-entity! this (-> this entity))
  (initialize-options this 0 1024.0 (the-as fact-info #f))
  (update-transforms (-> this root))
  (go-to-initial-state this)
  (none)
  )

(defstate wait (infobot)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch)
       ;; Player touched the infobot
       (go-virtual pickup #f (process->handle proc))
       )
      (else
        ;; Let the standard collectable handler deal with other events
        (collectable-standard-event-handler proc argc message block)
        )
      )
    )
    :code
    (behavior ()
      (loop
        ;; Always rotate to face jak
        (when *target*
          (let ((target-pos (-> *target* control trans))
                (self-pos (-> self root trans)))
            ;; Calculate angle to target
            (let ((angle (vector-y-angle (vector-! (new 'stack-no-clear 'vector) target-pos self-pos))))
              ;; Set rotation to face target
              (quaternion-set! (-> self root quat) 0.0 (sin (* 0.5 angle)) 0.0 (cos (* 0.5 angle)))
              )
            )
          )
        (let ((bob (-> self bob-amount)))
          (when (< 0.0 bob)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (* bob
                        (sin (* 27.30666 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 8))))))))
            (update-transforms (-> self root))      
          )
        )
        (suspend)))
  :post 
    (behavior ()
      (spawn (-> self part) (-> self root trans))  ;; ADDED: spawn particles every frame
      (transform-post)
    )
)


(deftype sol-crate (crate)
  ()
  )

(def-actor sol-crate
  :bounds (0 0 0 5))

(defmethod skel-init! ((this sol-crate))
  "Initialize the sol-crate's skeleton - uses sol-crate model instead of krimson crate"
  ;; Initialize skeleton - use sol-crate model
  (initialize-skeleton this *sol-crate-sg* '())
  (set! (-> this base quad) (-> this root trans quad))
  (crate-post)
  (nav-mesh-connect-from-ent this)
  (none)
  )

(defmethod crate-init! ((this sol-crate) (arg0 entity-actor))
  "Initialize the [[crate]] with the specified [[entity-actor]]."
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask crate))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) cshape-reaction-default)
    (set! (-> s4-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((v1-10 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-10 prim-core collide-as) (collide-spec crate notice-blue-eco-powerup))
      (set! (-> v1-10 prim-core collide-with) (collide-spec jak player-list tobot))
      (set! (-> v1-10 prim-core action) (collide-action solid rideable))
      (set! (-> v1-10 transform-index) 0) ;; set to 0 to use actual model collision of sol-crate.glb
      (set-vector! (-> v1-10 local-sphere) 0.0 2100.0 0.0 2024.0) ;; micro-adjustment of collision sphere 
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) v1-10)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-13 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-13 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-13 prim-core collide-with))
      )
    (set! (-> s4-0 penetrated-by)
          (penetrate
            generic-attack
            lunge
            flop
            punch
            spin
            roll
            uppercut
            bonk
            tube
            vehicle
            flut-attack
            board
            mech
            mech-punch
            dark-skin
            dark-punch
            dark-giant
            knocked
            )
          )
    (set! (-> this root) s4-0)
    )
  (set! (-> this fact)
        (new 'process 'fact-info-crate this (pickup-type eco-pill-random) (-> *FACT-bank* default-eco-pill-green-inc))
        )
  (when (-> this entity)
    (let ((v1-22 (-> this entity extra perm)))
      (set! (-> this fact pickup-amount)
            (fmax 0.0 (- (-> this fact pickup-amount) (the float (-> v1-22 user-int8 1))))
            )
      )
    )
  (when (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status subtask-complete)))
    (set! (-> this fact pickup-type) (pickup-type eco-pill-random))
    (set! (-> this fact pickup-amount) 0.0)
    )
  (when arg0
    (process-drawable-from-entity! this arg0)
    (logclear! (-> this mask) (process-mask actor-pause))
    )
  (let ((v1-37
          ((method-of-type res-lump get-property-struct)
           (-> this entity)
           'crate-type
           'interp
           -1000000000.0
           (the-as structure 'wood)
           (the-as (pointer res-tag) #f)
           *res-static-buf*
           )
          )
        )
    (set! (-> this look) (the-as symbol v1-37))
    (set! (-> this defense) (the-as symbol v1-37))
    )
  (set! (-> this carry)
        (new 'process 'carry-info this 3 (new 'static 'vector :w 1.0) (new 'static 'vector :y 1.0 :w 1.0) 0.0)
        )
  (set! (-> this carry max-pull) 3686.4)
  (set! (-> this carry carry-radius) 3276.8)
  (set! (-> this target) (the-as handle #f))
  (none)
  )

(defstate die (sol-crate)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touched)
       (case (-> self defense)
         (('darkeco)
          (send-event proc 'attack (-> block param 0) (static-attack-info ((id (new-attack-id)) (mode 'darkeco))))
          )
         )
       )
      )
    )
  :code (behavior ((arg0 symbol) (arg1 int))
    (logior! (-> self focus-status) (focus-status dead))
    (let ((v1-3 (-> (the-as collide-shape (-> self root)) root-prim)))
      (set! (-> v1-3 prim-core collide-as) (collide-spec))
      (set! (-> v1-3 prim-core collide-with) (collide-spec))
      )
    0
    (if (nonzero? (-> self sound))
        (stop! (-> self sound))
        )
    (let ((v1-10 (handle->process (-> self target))))
      (if (and (and v1-10 (= (-> v1-10 type) target) (focus-test? (the-as process-focusable v1-10) flut tube board pilot))
               (and (!= (-> self fact pickup-type) 10) (not arg0))
               )
          (logior! (-> self fact options) (actor-option suck-in))
          )
      )
    (when (not arg0)
      (suspend-for (seconds 0.04)
        )
      (logior! (-> self draw status) (draw-control-status no-draw))
      (case (-> self look)
        (('iron)
           ;; Vary volume of sol-crate-die based on distance from jak 
        (let ((distance-volume (calculate-distance-volume 
                                (-> self root trans)     ;; Crate position
                                75.0                     ;; Max volume (75%)
                                (meters 50))))                ;; Max distance
          (when (> distance-volume 0.0)
            (play-sound-file "sol-crate-die.mp3" (the int (* (-> *setting-control* user-current sfx-volume) distance-volume)))))
         )
        (('steel)
           ;; Vary volume of sol-crate-die based on distance from jak 
        (let ((distance-volume (calculate-distance-volume 
                                (-> self root trans)     ;; Crate position
                                75.0                     ;; Max volume (75%)
                                (meters 50))))                ;; Max distance
          (when (> distance-volume 0.0)
            (play-sound-file "sol-crate-die.mp3" (the int (* (-> *setting-control* user-current sfx-volume) distance-volume)))))
         )
        (('darkeco)
           ;; Vary volume of sol-crate-die based on distance from jak 
        (let ((distance-volume (calculate-distance-volume 
                                (-> self root trans)     ;; Crate position
                                75.0                     ;; Max volume (75%)
                                (meters 50))))                ;; Max distance
          (when (> distance-volume 0.0)
            (play-sound-file "sol-crate-die.mp3" (the int (* (-> *setting-control* user-current sfx-volume) distance-volume)))))
         )
        (else
          ;; Vary volume of sol-crate-die based on distance from jak 
        (let ((distance-volume (calculate-distance-volume 
                                (-> self root trans)     ;; Crate position
                                75.0                     ;; Max volume (75%)
                                (meters 50))))                ;; Max distance
          (when (> distance-volume 0.0)
            (play-sound-file "sol-crate-die.mp3" (the int (* (-> *setting-control* user-current sfx-volume) distance-volume)))))
          )
        )
      (case (-> self defense)
        (('darkeco)
         (let ((f0-0 (lerp-scale 1.0 0.0 (vector-vector-distance (-> self root trans) (target-pos 0)) 8192.0 40960.0)))
           (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 (the int (* 255.0 f0-0)) (seconds 0.3))
           )
         (process-spawn
           touch-tracker
           :init touch-tracker-init
           (-> self root trans)
           (-> *CRATE-bank* DARKECO_EXPLODE_RADIUS)
           30
           :to self
           )
         )
        )
      (case (-> self look)
        (('darkeco)
         (part-tracker-spawn :to self :group group-dark-eco-box-explosion :mat-joint (-> self root trans))
         )
        (('steel 'iron)
         (part-tracker-spawn :to self :group group-crate-steel-explode :mat-joint (-> self root trans))
         )
        (else
          (part-tracker-spawn :to self :group group-crate-explode :mat-joint (-> self root trans))
          )
        )
      )
    (case (-> self fact pickup-type)
      (((pickup-type money)
        (pickup-type buzzer)
        (pickup-type eco-blue)
        (pickup-type eco-yellow)
        (pickup-type eco-red)
        (pickup-type fuel-cell)
        (pickup-type gem)
        (pickup-type skill)
        )
       (go-virtual special-contents-die)
       )
      (((pickup-type health))
       (if (not (demo?))
           (talker-spawn-func (-> *talker-speech* 8) *entity-pool* (target-pos 0) (the-as region #f))
           )
       )
      )
   ;; MODIFIED: Spawn multiple pickups with random spread using drop-pickup
(let ((eco-array (res-lump-data (-> self entity) 'eco-info (pointer int32))))
  (if eco-array
      ;; Has eco-info - spawn up to 3 items with spread
      (let ((original-pos (new 'stack-no-clear 'vector)))
        ;; Save original crate position
        (set! (-> original-pos quad) (-> self root trans quad))

        (dotimes (i 3)
          (let ((pickup-id (-> eco-array (* i 2)))
                (amount (-> eco-array (+ (* i 2) 1))))
            ;; STRICT validation: pickup IDs 1-40, amounts 1-100
            (if (and (> pickup-id 0) 
                     (< pickup-id 40)
                     (> amount 0) 
                     (< amount 100))
                ;; Valid entry - modify position, spawn, restore
                (begin
                  ;; Set pickup type and amount
                  (set! (-> self fact pickup-type) (the-as pickup-type pickup-id))
                  (set! (-> self fact pickup-amount) (the float amount))

                  ;; Restore base position then add random offset
                  (set! (-> self root trans quad) (-> original-pos quad))
                  (+! (-> self root trans x) (* (rand-vu-float-range -1.0 1.0) (meters 5)))  ;; distance of x scatter
                  (+! (-> self root trans z) (* (rand-vu-float-range -1.0 1.0) (meters 5)))  ;; distance of z scatter
                  
                  ;; Spawn using the proven drop-pickup function
                  (drop-pickup (-> self fact) #t *entity-pool* (the-as fact-info #f) arg1)
                  )
                ;; Invalid - stop immediately
                (set! i 3)
                )
            )
          )
        
        ;; Restore original position
        (set! (-> self root trans quad) (-> original-pos quad))
        )
      ;; No eco-info - use default drop-pickup
      (drop-pickup (-> self fact) #t *entity-pool* (the-as fact-info #f) arg1)
      )
  )
    (process-entity-status! self (entity-perm-status dead) #t)
    (process-entity-status! self (entity-perm-status subtask-complete) #t)
    (suspend-for (seconds 5)
      )
    (when (logtest? (actor-option cond-respawn) (-> self fact options))
      (suspend-for (seconds 15)
        )
      (go-virtual hide)
      )
    )
  )

(deftype sol-crate-ammo (crate)
  ()
  )

(def-actor sol-crate-ammo
  :bounds (0 0 0 5))

(defmethod skel-init! ((this sol-crate-ammo))
  "Initialize the sol-crate-ammo's skeleton - uses sol-crate-ammo model instead of krimson crate"
  ;; Initialize skeleton - use sol-crate-ammo model
  (initialize-skeleton this *sol-crate-ammo-sg* '())
  (set! (-> this base quad) (-> this root trans quad))
  (crate-post)
  (nav-mesh-connect-from-ent this)
  (none)
  )

(defmethod crate-init! ((this sol-crate-ammo) (arg0 entity-actor))
  "Initialize the [[crate]] with the specified [[entity-actor]]."
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask crate))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
