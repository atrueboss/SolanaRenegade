  :id 1056
  :linger-duration (seconds 2)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 2)
  :parts ((sp-item 4590 :fade-after (meters 220) :period (seconds 0.5) :length (seconds 0.25))
    (sp-item 4591 :fade-after (meters 100))
    )
  )

