          (send-event (ppointer->process *time-of-day*) 'change 'hour 7)
          (set! (-> *mood-control* overide-weather-flag) #t)
          (set! (-> *mood-control* overide cloud) 0.4960) 
          (set! (-> *mood-control* overide fog) 0.5)
          )
        (('novalis)
