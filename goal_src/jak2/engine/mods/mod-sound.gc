(define *custom-music-transition-played-time* (the time-frame #f))

(defun custom-music-on-trigger ()
      (cond
       (  
        (and (pause-allowed?) (= (level-status *level* 'novalis) 'active) ;; if in this level
             (in-bubble-m? -24.89 70.72 16.59 25.0) ;; trigger location in level
             (not (string= *current-playing-custom-music-str* "novalis/novalis-sewers.wav")) ;; if not currently playing then allow to play
        )      
        (and (stop-main-music) ;; stops the old music with fade-out
             (format (clear *current-playing-custom-music-str*) "novalis/novalis-sewers.wav" (+ 68 1)) ;; set current-playing-custom-music to new trac
             (play-sound-file "transitions/novalis-enter-sewers.wav" (the int (* 100.0(-> *setting-control* user-current sfx-volume)))) ;; play transition sound
             ;; (let ((some-time (current-time))) (when (time-elapsed? some-time (seconds 3))(suspend)))
             (play-main-music "novalis/novalis-sewers.wav" (the int (* 100.0(-> *setting-control* user-current music-volume)))) ;; play new music
             (format (clear *current-playing-custom-music-str*) "novalis/novalis-sewers.wav" (+ 68 1)) ;; set current playing music to new music
        )     
       )
       (
        (and (pause-allowed?) (= (level-status *level* 'batalia) 'active) ;; if in this level
             (in-bubble-m? -122.60 50.17 -169.69 20.0) ;; trigger location in level
             (not (string= *current-playing-custom-music-str* "batalia/batalia-rail.wav")) ;; if not currently playing then allow to play
        )      
        (and 
             (stop-main-music) ;; stops the old music with fade-out
             (format (clear *current-playing-custom-music-str*) "batalia/batalia-rail.wav" (+ 68 1)) ;; set current-playing-custom-music to new track
             (play-sound-file "transitions/aridia-enter-swingshot.wav" (the int (* 100.0(-> *setting-control* user-current sfx-volume)))) ;; play transition sound
             ;; add delay here ;; 
             (play-main-music "batalia/batalia-rail.wav" (the int (* 100.0(-> *setting-control* user-current music-volume)))) ;; play new music
             (format (clear *current-playing-custom-music-str*) "batalia/batalia-rail.wav" (+ 68 1)) ;; set current playing music to new music
        )     
       )
      )
(none)  
)    


(defun custom-talker-on-trigger ()
    (cond  
        ((and (pause-allowed?) (= (level-status *level* 'novalis) 'active) ;; if in this level and unpaused
              (in-bubble-m? -24.89 70.72 16.59 25.0)) ;; entrance to novalis-sewers
         (script-eval '(talker-spawn "ds151")) ;; "use your jetboard!"
        )
        ((and (pause-allowed?) (= (level-status *level* 'batalia) 'active) ;; if in this level and unpaused
              (in-bubble-m? -131.59 52.00 -206.71 20.0))  ;; infront of batalia grind rail
         (script-eval '(talker-spawn "ds372")) ;; "gotta ride jetboard on this one jak!"
        )    
    )
(none)
)